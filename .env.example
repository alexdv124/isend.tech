# Local development. This file contains no working credentials.
# Load explicitly: node --env-file=.env server.mjs
PORT=8788
PUBLIC_ORIGIN=http://127.0.0.1:8788
# Optional comma-separated additional origins:
# PUBLIC_ORIGINS=http://localhost:8788
# Leave unset without a trusted reverse proxy:
# TRUST_PROXY=loopback
# Optional persistent server metadata (never commit these files):
# PAIRING_STORE=./data/pairs.json
# DIAGNOSTICS_DIR=./data/diagnostics
# ANALYTICS_AUDIENCE_FILE=./data/diagnostics/audience.json
# Optional self-hosted TURN (use your own shared secret):
# TURN_AUTH_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# Alternative to self-hosted TURN: set BOTH Cloudflare credentials, server-side only.
# CF_TURN_KEY_ID=REPLACE_WITH_KEY_ID
# CF_TURN_API_TOKEN=REPLACE_WITH_API_TOKEN
