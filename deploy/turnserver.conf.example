# coturn template; install separately from the Node application.
# Replace all placeholders before starting. Never commit the real shared secret.
listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_A_NEW_RANDOM_SECRET
realm=turn.example.com
server-name=turn.example.com
cert=/etc/isend-turn/fullchain.pem
pkey=/etc/isend-turn/privkey.pem
min-port=49160
max-port=49359
# Initial resource bounds; size for expected usage.
user-quota=4
total-quota=128
stale-nonce=600
no-cli
no-multicast-peers
no-tlsv1
no-tlsv1_1
# Block relay access to internal destinations. Extend for your network and IPv6.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
# If behind NAT: external-ip=PUBLIC_IP/PRIVATE_IP (configure for your host).
