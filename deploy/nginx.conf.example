# Add as a NEW virtual host. Do not replace your existing nginx.conf.
# Obtain TLS certificates and replace the host before enabling this file.
server {
    listen 80;
    server_name send.example.com;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name send.example.com;
    ssl_certificate /etc/letsencrypt/live/send.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/send.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 24k;
    location / {
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite the client header: discovery/rate limits trust this value.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
    }
}
